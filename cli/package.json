{
  "name": "yaaa-cli-workspace",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen": "buf generate ../proto --template buf.gen.yaml",
    "lint:proto": "cd .. && buf lint",
    "build": "pnpm gen && tsc -b packages/cli && node scripts/copy-skills.mjs",
    "typecheck": "tsc -b packages/cli",
    "test": "vitest run",
    "reference": "node scripts/reference.mjs",
    "yaaa": "node packages/cli/dist/main.js"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1"
    }
  }
}
